# Template for infrastructure/components/vault/.env (gitignored). Copy it and fill in the values:
#
#   cp .env.example .env
#
# This file is also the manifest read by infrastructure/components/vault/scripts/configure-secrets.sh:
# every <SERVICE>_* variable listed here must be set in .env before that service is pushed to Vault.
# Keep it in sync when you add a secret; never put real values in this file.
#
# Format: KEY=VALUE, one per line, no inline comments. Quote values that start or end with
# whitespace. Spaces, '$' and '#' inside a value are fine (the file is parsed, not sourced).
# The mapping to Vault is <SERVICE>_<GROUP>_<FIELD> -> secret/<service>, key <group>.<field>.

# --- Vault (optional) ---------------------------------------------------------------
# scripts/start.sh writes the unseal key and root token to infrastructure/components/vault/.vault-init
# on first run. Set them here only if you manage them yourself; values here take precedence.
# VAULT_ADDR=http://127.0.0.1:5002
# VAULT_UNSEAL_KEY=
# VAULT_TOKEN=

# --- identity-access -> secret/identityaccess, database/*identityaccess-postgresql* -----
IDENTITYACCESS_DEBEZIUM_USERNAME=
IDENTITYACCESS_DEBEZIUM_PASSWORD=
# Gmail: use an app password, not the account password
IDENTITYACCESS_MAIL_USERNAME=
IDENTITYACCESS_MAIL_PASSWORD=
IDENTITYACCESS_REDIS_USERNAME=
IDENTITYACCESS_REDIS_PASSWORD=
# openssl rand -hex 32
IDENTITYACCESS_REFRESH_SALT=
IDENTITYACCESS_REFRESH_PASSWORD=
# Admin account Vault uses to create dynamic Postgres roles
IDENTITYACCESS_DB_VAULT_USERNAME=
IDENTITYACCESS_DB_VAULT_PASSWORD=

# --- profile -> secret/profile, database/*profile-postgresql* ---------------------------
PROFILE_DEBEZIUM_USERNAME=
PROFILE_DEBEZIUM_PASSWORD=
PROFILE_REDIS_USERNAME=
PROFILE_REDIS_PASSWORD=
PROFILE_CLOUDINARY_CLOUD_NAME=
PROFILE_CLOUDINARY_API_KEY=
PROFILE_CLOUDINARY_API_SECRET=
PROFILE_CLOUDINARY_SECURE=true
PROFILE_DB_VAULT_USERNAME=
PROFILE_DB_VAULT_PASSWORD=

# --- api-gateway -> secret/apigateway ------------------------------------------------------
APIGATEWAY_REDIS_USERNAME=
APIGATEWAY_REDIS_PASSWORD=

# --- message -> secret/message, database/*message-postgresql*, database/*message-scylladb* ---
MESSAGE_DEBEZIUM_USERNAME=
MESSAGE_DEBEZIUM_PASSWORD=
MESSAGE_REDIS_USERNAME=
MESSAGE_REDIS_PASSWORD=
MESSAGE_CLOUDINARY_CLOUD_NAME=
MESSAGE_CLOUDINARY_API_KEY=
MESSAGE_CLOUDINARY_API_SECRET=
MESSAGE_CLOUDINARY_SECURE=true
MESSAGE_DB_VAULT_USERNAME=
MESSAGE_DB_VAULT_PASSWORD=
MESSAGE_SCYLLA_VAULT_USERNAME=
MESSAGE_SCYLLA_VAULT_PASSWORD=
