# Copy to .env (gitignored) and set real values. Read by docker-compose.yml.
# Vault: copy POSTGRES_USER / POSTGRES_PASSWORD into the <SERVICE>_DB_VAULT_USERNAME / _PASSWORD
# entries of ../vault/.env so Vault can create dynamic database roles.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=chatter
# Port published on the host
POSTGRES_PORT=5432

# Credentials of the identity-access CDC relay (Debezium). Static values, not managed by Vault.
# Read by scripts/create-relay-role.sh (creates the role) and by the Kafka Connect worker.
# Empty or "change-me..." values are refused.
IDENTITYACCESS_DEBEZIUM_USERNAME=
IDENTITYACCESS_DEBEZIUM_PASSWORD=
