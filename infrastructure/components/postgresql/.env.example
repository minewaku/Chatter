# Copy to .env (gitignored) and set real values. Read by docker-compose.yml.
# Vault: copy POSTGRES_USER / POSTGRES_PASSWORD into the <SERVICE>_DB_VAULT_USERNAME / _PASSWORD
# entries of ../vault/.env so Vault can create dynamic database roles.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=chatter
# Port published on the host
POSTGRES_PORT=5432
