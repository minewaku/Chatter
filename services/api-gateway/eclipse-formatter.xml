<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<profiles version="22">
    <profile kind="CodeFormatterProfile" name="Custom_Eclipse_Formatter" version="22">
        
        <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
        <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
        <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>

        <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="180"/>

        <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_annotation" value="83"/>
        
        <setting id="org.eclipse.jdt.core.formatter.insert_space_before_opening_paren_in_annotation" value="do not insert"/>
        <setting id="org.eclipse.jdt.core.formatter.insert_space_after_opening_paren_in_annotation" value="do not insert"/>

        <setting id="org.eclipse.jdt.core.formatter.brace_position_for_type_declaration" value="end_of_line"/>
        <setting id="org.eclipse.jdt.core.formatter.brace_position_for_method_declaration" value="end_of_line"/>
        <setting id="org.eclipse.jdt.core.formatter.brace_position_for_block" value="end_of_line"/>
        
    </profile>
</profiles>